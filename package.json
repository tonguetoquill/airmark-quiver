{
  "name": "@airmark/quiver",
  "version": "0.35.7-dev",
  "description": "Airmark Quiver — Air Force and DAF document Quills for Quillmark.",
  "type": "module",
  "exports": {
    "./Quiver.yaml": "./Quiver.yaml",
    "./quills/*": "./quills/*",
    "./templates/*": "./templates/*",
    "./package.json": "./package.json"
  },
  "files": [
    "quills",
    "templates",
    "Quiver.yaml"
  ],
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@quillmark/quiver": "0.35.0",
    "@quillmark/wasm": "^0.124.0",
    "quillkit": "0.15.0"
  },
  "scripts": {
    "test": "quillkit test && node scripts/check-examples.mjs && node scripts/check-templates.mjs",
    "site": "quillkit site --out site --drafts --templates templates",
    "dev": "quillkit studio --templates templates"
  },
  "keywords": [
    "quillmark",
    "quiver",
    "typst",
    "usaf",
    "daf",
    "airmark"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tonguetoquill/airmark-quiver"
  }
}
