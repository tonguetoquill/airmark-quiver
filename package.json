{
  "name": "@airmark/quiver",
  "version": "0.41.0",
  "description": "Airmark Quiver — Air Force, DAF and Army document Quills for Quillmark.",
  "type": "module",
  "exports": {
    "./Quiver.yaml": "./Quiver.yaml",
    "./quills/*": "./quills/*",
    "./templates/*": "./templates/*",
    "./package.json": "./package.json"
  },
  "files": [
    "quills",
    "templates",
    "Quiver.yaml"
  ],
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@quillmark/quiver": "0.39.0",
    "@quillmark/wasm": "0.133.0",
    "quillkit": "0.20.0"
  },
  "scripts": {
    "test": "quillkit check && node scripts/check-examples.mjs && node scripts/check-templates.mjs",
    "build": "quillkit build --drafts",
    "dev": "quillkit serve"
  },
  "keywords": [
    "quillmark",
    "quiver",
    "typst",
    "usaf",
    "daf",
    "army",
    "airmark"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tonguetoquill/airmark-quiver"
  },
  "overrides": {
    "@quillmark/wasm": "$@quillmark/wasm"
  }
}
